# Postgres (in dev: `npm run db:start` avvia il DB embedded su questa porta)
DATABASE_URL="postgresql://confermo:confermo@localhost:5433/confermo"
# Segreto per i cookie di sessione — generare un valore casuale in produzione
JWT_SECRET="cambiami"
PORT=3001
# mock | twilio — con "mock" le clinic senza canale WhatsApp usano il provider finto
MESSAGING_PROVIDER=mock
# Chiave AES-256-GCM (32 byte base64) per cifrare le API key dei canali WhatsApp.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""
# Base URL pubblica (https in produzione): serve per l'URL del webhook 360dialog
APP_BASE_URL=http://localhost:3001
